# =============================================================================
# Desktop Ghost Live Agent — Environment Configuration Template
# =============================================================================
# 1. Copy this file to .env:
#    cp .env.example .env   (or copy-paste in File Explorer)
# 2. Add your Google Gemini API key from https://aistudio.google.com/app/apikey
# =============================================================================

# Primary Gemini API Key (Required)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Secondary keys for dynamic fallback & rotation on 503 / 429 quota spikes
# GEMINI_API_KEY2=your_secondary_gemini_api_key
# GEMINI_API_KEY3=your_tertiary_gemini_api_key
# GEMINI_API_KEY4=
# GEMINI_API_KEY5=

# Voice Configuration (Puck, Charon, Kore, Fenrir, Aoede)
GHOST_VOICE=Puck

# Gemini Thinking Configuration (off, minimal, low, high)
GHOST_THINKING_LEVEL=off
